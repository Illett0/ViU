{
  "name": "viu",
  "version": "0.3.0",
  "description": "Googleタイムライン位置履歴から都道府県制覇マップ・移動統計を可視化するデスクトップアプリ",
  "main": "main.js",
  "author": "_Illett_",
  "repository": {
    "type": "git",
    "url": "https://github.com/Illett0/ViU.git"
  },
  "scripts": {
    "start": "electron .",
    "fetch:boundaries": "node scripts/fetch-municipality-boundaries.js",
    "dist": "electron-builder",
    "test:e2e": "node test/e2e/run-all.js",
    "setup": "allow-scripts"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@lavamoat/allow-scripts": "5.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.61.1"
  },
  "dependencies": {
    "@turf/bbox": "^7.1.0",
    "@turf/boolean-point-in-polygon": "^7.1.0",
    "@turf/helpers": "^7.1.0",
    "exifr": "^7.1.3",
    "heic-decode": "^2.1.0",
    "leaflet": "^1.9.4"
  },
  "build": {
    "appId": "dev.illett.viu",
    "productName": "ViU",
    "compression": "maximum",
    "electronLanguages": [
      "ja",
      "en",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "worker/**/*",
      "renderer/**/*",
      "data/**/*",
      "package.json",
      "!node_modules/**/{test,tests,example,examples,*.md}",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.travel",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ViU",
      "menuCategory": false
    }
  },
  "lavamoat": {
    "allowScripts": {
      "electron-builder>app-builder-lib>electron-builder-squirrel-windows>electron-winstaller#5.4.0": true
    }
  }
}
